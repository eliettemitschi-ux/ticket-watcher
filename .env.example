# Copy this file to .env and fill in the values you want to use.
# Nothing here is required to get the dashboard running, but you need at
# least one notification channel configured for alerts to actually reach you.

# --- Dashboard ---
PORT=3000
# Basic-auth login for the dashboard (leave both blank to disable auth --
# not recommended if the server is reachable from the open internet).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- ntfy.sh push notifications ---
# Pick any topic name (make it hard to guess, it's not private otherwise),
# e.g. https://ntfy.sh/eliette-tickets-a8f3 -- then subscribe to that same
# topic in the ntfy app (iOS/Android) or at https://ntfy.sh/app in a browser.
NTFY_TOPIC=

# Self-hosted or paid ntfy server instead of ntfy.sh (optional).
NTFY_SERVER=https://ntfy.sh

# --- Email notifications (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Who the alert emails are sent from and to (can be the same address).
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# --- Checker behaviour ---
# How often, in minutes, every event gets checked. As long as
# `node server.js` is running, this happens automatically -- there's
# nothing else to install or schedule.
POLL_INTERVAL_MINUTES=10

# Leave this as true unless you have a specific reason to run checks from
# your own separate scheduler (Windows Task Scheduler, cron, etc. -- see
# the README) instead of automatically inside server.js. If you do set it
# to false, remember checks won't happen at all unless something else is
# actually running `node check.js` on a schedule.
AUTO_CHECK=true
